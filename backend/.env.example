# Local development environment for Amazon-AI-Fulfillment-Agent.
# This file is gitignored — never commit it. Generated during Phase 2A
# database-foundation work to support a dedicated local PostgreSQL instance.

# Application Environment
APP_ENV=development

# Backend Configuration
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# Frontend Configuration
FRONTEND_PORT=3000

# Database (PostgreSQL) — dedicated local dev instance for this project only.
# Host-side tools (Alembic run from this shell) reach it via localhost:5434.
# The backend container reaches it via the Compose service hostname
# "postgres" on container port 5432 (wired directly in docker-compose.yml).
POSTGRES_DB=amazon_fulfillment
POSTGRES_USER=amazon_fulfillment
POSTGRES_PASSWORD=jCqkh3_zQH7oUbwfCQES9I6egnGd2LuW
DATABASE_URL=postgresql+asyncpg://amazon_fulfillment:jCqkh3_zQH7oUbwfCQES9I6egnGd2LuW@localhost:5434/amazon_fulfillment

# Authentication / JWT (local dev only — not a production secret)
SECRET_KEY=dev-local-only-secret-do-not-use-in-production-a1b2c3
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Google Sheets MCP server (service account key file path)
# PATH CONVENTION: interpreted RELATIVE TO THE REPO ROOT (where this .env
# lives), the same way docker-compose's env_file resolves paths -- NOT
# relative to backend/ even though backend jobs run with backend/ as cwd.
# jobs/process_sheet_orders.py load_dotenv()s this file and resolves the
# value against the repo root, so it works when run from backend/.
# NOTE: the previous value (google-service-account.json) is a DELETED/
# rotated key (Google returns invalid_grant for it). The live key for
# sheets-fulfillment-bot@amazon-fulfillment-agent is the 117e44d6db29 file.
GOOGLE_SHEETS_CREDENTIALS_PATH=backend/credentials/amazon-fulfillment-agent-117e44d6db29.json

# Default organization for sheet-sourced orders (set after DB is running)
DEFAULT_ORGANIZATION_ID=9a32c88e-fe0c-48e0-87e8-f9785e1cc50a
# Spreadsheet used by jobs/process_sheet_orders.py (single fixed intake
# sheet, 'tiktok-shop', shared with the service account below). Same
# repo-root-relative convention as GOOGLE_SHEETS_CREDENTIALS_PATH above.
SHEET_ID=1huZFTi7NTzf-evJ63BjuizfovDLUH0ETVJUbJA0Npmg
