[TEMPLATE — fill in values for your client, do not commit real values]

# ===========================================================================
# Pipeline stage 1 — TikTok Shop (optional until OAuth approved; sheet is the
# fallback manual-entry point until then)
# ===========================================================================
# Get these from TikTok Shop Partner Center
#   https://partner.tiktokshop.com  →  create/register an app
TIKTOK_SHOP_APP_KEY=
TIKTOK_SHOP_APP_SECRET=
# Access / refresh tokens come from the app's OAuth flow once a real shop
# authorizes it. TIKTOK_SHOP_ACCESS_TOKEN is optional — leaving it blank
# means the provider will refresh on first use.
TIKTOK_SHOP_ACCESS_TOKEN=
TIKTOK_SHOP_REFRESH_TOKEN=
# The authorized shop's ID, shown in Partner Center / Seller Center after
# authorization.
TIKTOK_SHOP_SHOP_ID=
# Leave sandbox until TikTok OAuth is approved and you're ready to go live.
TIKTOK_SHOP_ENVIRONMENT=sandbox  # or production

# ===========================================================================
# Pipeline stage 2 — Google Sheets
# ===========================================================================
# The Google Sheet that holds the Orders tab. Get the ID from the sheet URL:
#   https://docs.google.com/spreadsheets/d/<SHEET_ID>/edit
SHEET_ID=

# Path to a Google service account JSON key file on disk. The generic Google
# Sheets MCP server uses this. Create a service account in Google Cloud Console
# → enable the Sheets API → create a key → download JSON → share the sheet
# with the service account's email (Editor access).
GOOGLE_SHEETS_CREDENTIALS_PATH=

# Worksheet/tab name inside the sheet that holds the Orders header row.
# The processing job reads/writes this tab by name.
GOOGLE_SHEETS_WORKSHEET_NAME=Orders

# ===========================================================================
# Pipeline stage 3 — Amazon SP-API
# ===========================================================================
# Amazon Seller Central → Develop Apps → register a PRIVATE SP-API app
# (no Amazon public-app review needed for private apps). Self-authorize to
# get the LWA credentials below.
AMAZON_LWA_CLIENT_ID=
AMAZON_LWA_CLIENT_SECRET=
AMAZON_LWA_REFRESH_TOKEN=
# AWS region that hosts the SP-API endpoints for your marketplace.
AMAZON_SP_API_REGION=na  # na, eu, or fe
# Your target Amazon marketplace ID. US is ATVPDKIKX0DER; see Amazon docs
# for other marketplaces.
AMAZON_MARKETPLACE_ID=ATVPDKIKX0DER
# Must be explicitly set to "production" to call real Amazon endpoints.
AMAZON_ENVIRONMENT=sandbox  # or production

# ===========================================================================
# Shared / infra
# ===========================================================================
# Each client deployment gets its own DB. Set the connection string for that DB.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/amazon_fulfillment
# JWT signing secret — generate a strong random value for each deployment.
SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
# Default org ID used by the sheet-processing job when no org context is
# available. Set to the UUID of the org created during onboarding.
DEFAULT_ORGANIZATION_ID=
# Slack webhook URL for notifications (optional — leave blank to use the log
# provider). Create at https://api.slack.com/messaging/webhooks
SLACK_WEBHOOK_URL=
# Max Amazon order price (USD) that auto-approves. Above this, or if price
# can't be determined, the workflow stops for human review.
MAX_ALLOWED_PRICE_USD=500.00
# Notification provider: "log" (default) or "slack"
NOTIFICATION_PROVIDER=log