[TEMPLATE]
# Application Environment
APP_ENV=development

# Backend Configuration
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# Frontend Configuration
FRONTEND_PORT=3000

# Database (PostgreSQL)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/amazon_fulfillment

# Authentication / JWT
SECRET_KEY=change-this-to-a-strong-random-secret-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Amazon SP-API Configuration (optional — leave unset for mock-only mode)
# See docs/amazon-human-activation-checklist.md before setting these.
# AMAZON_LWA_CLIENT_ID=
# AMAZON_LWA_CLIENT_SECRET=
# AMAZON_LWA_REFRESH_TOKEN=
# AMAZON_SP_API_REGION=na
# AMAZON_MARKETPLACE_ID=ATVPDKIKX0DER
# AMAZON_ENVIRONMENT=sandbox

# TikTok Shop Open API Configuration (optional — leave unset to disable the
# integration; see app/services/providers/tiktok/ and docs/tiktok-integration.md)
# TIKTOK_APP_KEY=
# TIKTOK_APP_SECRET=
# TIKTOK_ACCESS_TOKEN=
# TIKTOK_REFRESH_TOKEN=
# TIKTOK_SHOP_ID=
# TIKTOK_ENVIRONMENT=sandbox

# Google Sheets integration (optional — leave unset to disable; see
# app/services/google_sheets/client.py). Service account key as a raw JSON
# string, not a file path.
# GOOGLE_SHEETS_SPREADSHEET_ID=
# GOOGLE_SHEETS_CREDENTIALS_JSON=
# GOOGLE_SHEETS_WORKSHEET_NAME=Sheet1

# ---------------------------------------------------------------------------
# MCP servers (backend/mcp_servers/) — see backend/mcp_servers/README.md.
# Reuse the Amazon/TikTok credentials above; these two are MCP-server-only.
# ---------------------------------------------------------------------------

# Path to a Google service account key FILE for the generic Google Sheets
# MCP server (backend/mcp_servers/google_sheets/) — distinct from
# GOOGLE_SHEETS_CREDENTIALS_JSON above, which is a JSON string used only by
# the app's own narrow TikTok-order sync path.
# GOOGLE_SHEETS_CREDENTIALS_PATH=

# When true, the tiktok_shop MCP server (backend/mcp_servers/tiktok_shop/)
# returns synthetic fixture data instead of calling the real TikTok Shop
# provider — for testing the MCP tool surface without real credentials.
# TIKTOK_MOCK_MODE=false

# ---------------------------------------------------------------------------
# Amazon pricing provider — backs check_price/check_inventory/get_product in
# the amazon MCP server AND the fulfillment workflow's price safety-gate
# (see app/services/providers/pricing_base.py and
# backend/mcp_servers/README.md's "Pricing providers" section).
#
# This is an explicit deploy-time choice, not an accident — PRICING_PROVIDER
# defaults to "mock" precisely so a deployment never silently starts making
# real external calls (or worse, real scraping) just because credentials
# happened to be present. Pick ONE:
#
#   mock   (default) — deterministic synthetic data. Always "works"; not
#           real. Safe for dev/test; NOT suitable for production price
#           checks (the safety-gate will pass orders based on fake prices).
#   pa_api — real Amazon Product Advertising API v5 data. Requires an
#           APPROVED Amazon Associates (affiliate) account — PA-API access
#           can be revoked for accounts that don't generate qualifying sales
#           volume. Set AMAZON_PA_API_ENABLED=true plus the credentials
#           below. See services/providers/amazon/pa_api_pricing.py.
#   scrape — parses amazon.com's public product page. No credentials
#           needed, but fragile (page markup changes without notice) and
#           ToS-sensitive (Amazon's Conditions of Use prohibit automated
#           scraping of the retail site outside licensed APIs) — LAST
#           RESORT ONLY. Set AMAZON_SCRAPE_PRICING_ENABLED=true. See
#           services/providers/amazon/scrape_pricing.py.
PRICING_PROVIDER=mock

# Maximum Amazon price (USD) a fulfillment order may proceed past
# automatically. Above this — or if the price can't be determined at all —
# the order is routed to human review, never auto-approved. See
# services/fulfillment/workflow.py's _step_check_price_guard.
MAX_ALLOWED_PRICE_USD=500.00

# Product Advertising API (only used when PRICING_PROVIDER=pa_api). Get
# these from an approved Amazon Associates account (associates.amazon.com)
# with PA-API access enabled.
# AMAZON_PA_API_ENABLED=false
# AMAZON_PA_API_ACCESS_KEY=
# AMAZON_PA_API_SECRET_KEY=
# AMAZON_PA_API_PARTNER_TAG=
# AMAZON_PA_API_PARTNER_TYPE=Associates
# AMAZON_PA_API_MARKETPLACE=www.amazon.com
# AMAZON_PA_API_REGION=us-east-1
# AMAZON_PA_API_HOST=webservices.amazon.com

# Scraping fallback (only used when PRICING_PROVIDER=scrape). No
# credentials — just an explicit opt-in, given the ToS/fragility caveats
# above.
# AMAZON_SCRAPE_PRICING_ENABLED=false

# ---------------------------------------------------------------------------
# Notification provider — backs the notifications MCP server
# (backend/mcp_servers/notifications/), which alerts a human when a
# fulfillment order needs review (WAITING_APPROVAL or FAILED — e.g. the
# price safety-gate above). Defaults to "log" (writes a real log line —
# never fabricates having reached a human, but doesn't page anyone) so
# real alerting is a deliberate choice. Pick ONE:
#
#   log   (default) — writes to the application log only.
#   slack — posts to a Slack incoming-webhook URL. Set SLACK_WEBHOOK_URL
#           below. See services/providers/slack/webhook.py.
NOTIFICATION_PROVIDER=log

# Slack incoming-webhook URL (only used when NOTIFICATION_PROVIDER=slack).
# Create one at https://api.slack.com/messaging/webhooks for the channel
# you want alerts posted to. Treat this URL as a credential — anyone who
# has it can post to that channel.
# SLACK_WEBHOOK_URL=

# ---------------------------------------------------------------------------
# Oracle Cloud / Docker Compose deployment only (see docs/oracle-cloud-deployment.md)
# Not needed for local `npm run dev` / `uvicorn --reload` development.
# ---------------------------------------------------------------------------

# Comma-separated extra CORS origins the backend should accept requests
# from, beyond localhost (e.g. your OCI frontend domain and/or Vercel URL).
# ALLOWED_ORIGINS=https://app.yourdomain.com,https://your-app.vercel.app

# Domains routed by Caddy (docker-compose.yml / deploy/Caddyfile).
# FRONTEND_DOMAIN=app.yourdomain.com
# API_DOMAIN=api.yourdomain.com

# Backend URL baked into the frontend's JS bundle at Docker build time.
# NEXT_PUBLIC_API_BASE_URL=https://api.yourdomain.com
